# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Node (if any tooling is added later)
node_modules/

# Secrets — never commit
.env
.env.*
*.pem
*.key

# the-owl loop runtime state (ephemeral; not the vault, not the config)
.owl/state/
.owl/last-run.json

# tokensave local index (per-machine state; git rm -r --cached .tokensave to untrack)
.tokensave/

# hygiene quarantine (review & delete manually)
_quarantine-*/

# DevFlow ephemeral sessions
.devflow/sessions/

# Obsidian local UI state (keep shareable config: app/appearance/core-plugins/graph)

# Obsidian local vault state (churns on every open; not part of the-owl)
research-vault/.obsidian/
graphify-out/
